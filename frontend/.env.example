# Copy to frontend/.env. Only VITE_ variables reach the browser: never put secrets here.

# Leave empty in development: Vite forwards /api and /ws to Django on :8000.
VITE_API_URL=

# Same value as GOOGLE_CLIENT_ID in backend/.env
VITE_GOOGLE_CLIENT_ID=

# Razorpay key id only (never the secret)
VITE_RAZORPAY_KEY_ID=

VITE_GOOGLE_MAPS_API_KEY=
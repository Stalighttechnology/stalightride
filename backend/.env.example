DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=synchoo
DB_USER=synchoo
DB_PASSWORD=synchoo
DB_HOST=localhost
DB_PORT=5432

# Where password-reset links point
FRONTEND_URL=http://localhost:8080

# Google sign-in: OAuth client ID (type "Web application"),
# authorised redirect URI http://localhost:8080/auth
GOOGLE_CLIENT_ID=

# Razorpay (test keys start with rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email: leave EMAIL_HOST empty to print emails in the server console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Synchoo <no-reply@localhost>

# Uploaded files; default is backend/media
# MEDIA_ROOT=